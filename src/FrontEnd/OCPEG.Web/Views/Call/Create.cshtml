@model OCPEG.Web.ViewModels.CallViewModel

@{
    ViewData["Title"] = "Atendimento";
    var priorits = new SelectList(Model.Priority, "Id", "Name");
    var products = new SelectList(Model.Product, "Id", "Name");
}

<br />
<br />
<div class="container border p-3">
    <h1 class="text-primary">Atendimento</h1>

    <h4 class="pt-2">Inclusão</h4>

    <div class="row pt-3">
        <div class="col-md-4">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
                <div id="divCustomerSearch" class="form-group pt-3"  >
                    <label class="control-label">Cliente</label>
                    <div style="display:inline-flex">
                        <input id="CustomerName" class="form-control"/>
                        <input type="button" id="btnCustomerSearch" class="btn btn-outline-success" value="Pesquisar"/>
                    </div>
                </div>
                <div id="divCustomer" class="form-group pt-3" style="display:none">
                    <label asp-for="Customer.Id" class="control-label">Cliente</label>
                    <select asp-for="Customer.Id" class="btn btn-secondary dropdown-toggle"></select>
                    <span asp-validation-for="Customer.Id" class="text-danger"></span>
                    <input type="button" id="btnCustomerBack" class="btn btn-outline-success" value="Voltar"/>
                </div>            
            
                <div class="form-group pt-3">
                    <label asp-for="ProductId" class="control-label">Assunto</label>
                
                    <select asp-for="ProductId" asp-items="@products" class="btn btn-secondary dropdown-toggle">
                        <option>--- Selecionar ---</option>
                    </select>
                </div>

                <div class="form-group pt-3">
                    <label asp-for="PriorityId" class="control-label">Prioridade</label>
                
                    <select asp-for="PriorityId"  asp-items="@priorits" class="btn btn-secondary dropdown-toggle">
                        <option>--- Selecionar ---</option>
                    </select>
                </div>
                <div class="form-group pt-3">
                    <label asp-for="Comment" class="control-label">Comentário</label>
                    <textarea asp-for="Comment" rows="5" cols="40" class="form-control"></textarea>
                    <span asp-validation-for="Comment" class="text-danger"></span>
                </div>
                <div class="form-group pt-4">
                    <input type="submit" value="Salvar" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
</div>


<div class="pt-4">
    <a asp-action="Index">Voltar para Lista</a>
</div>


<script language="javascript" type="text/javascript">
    
    $(document).ready(function() {
        $("#CustomerName").focus();

        $("#btnCustomerSearch").on("click", function () {
            window.ocPegCall.CustomerSearch();
        });

        $("#btnCustomerBack").on("click", function () {
            window.ocPegCall.CustomerBack();
        });
    });

</script>