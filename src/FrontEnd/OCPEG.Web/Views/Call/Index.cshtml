@model IEnumerable<OCPEG.Web.ViewModels.CallViewModel>

@{
    ViewData["Title"] = "Index";
}

<br/>
<br/>
<div class="container p-4 border">
    <div class="row pb-2">
        <div class="col">
            <h1 class="text-primary">Atendimento</h1>
        </div>
        <div class="col text-end pt-1">
            <a asp-action="Create" class="btn btn-outline-primary">
                <i class="fas fa-plus"></i>&nbsp;Criar Atendimento
            </a>
        </div>
    </div>   
    
    <table class="table">
        <thead>
            <tr>
                <th>
                    Protocolo
                </th>
                <th>
                    Data de Início
                </th>
                <th>
                    Prioridade
                </th>
                <th>
                    Status
                </th>
                <th>
                    Cliente
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
    @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.CallNumber)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.StartDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PrioritySel!.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.StatusSel!.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Customer!.Name)
                </td>
                <td>
                        <a asp-action="Edit" class="btn btn-outline-success" asp-route-id="@item.Id">
                        <i class="fas fa-edit"></i>&nbsp;Detalhes do Protocolo
                    </a>
                </td>
            </tr>
    }
        </tbody>
    </table>
</div>

<div>
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
</div>
