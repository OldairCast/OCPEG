@model OCPEG.Domain.Dto.CustomerDto

@{
    ViewData["Title"] = "Cliente";
}


<br />
<br />
<div class="container border p-3">
    <h1 class="text-primary">Cliente</h1>

    <h4 class="pt-2">Confirma a Exclusão?</h4>

    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Nome
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            Email
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>
        <dt class = "col-sm-2">
            Telefone
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Telephone)
        </dd>
    </dl>

    <div class="row pt-3">
        <div class="col-md-4">
            <form asp-action="Delete" class="pt-4">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" id="Id" name="Id" value="@Model?.CustomerId" />
                <input type="submit" value="Excluir" class="btn btn-danger" /> 
            </form>
        </div>
    </div>
</div>

<div class="pt-4">
    <a asp-action="Index">Voltar para Lista</a>
</div>
