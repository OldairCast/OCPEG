@model OCPEG.Domain.BusinessObject.CustomerType

@{
    ViewData["Title"] = "Tipo de Cliente";
}

<br />
<br />
<div class="container border p-3">
    <h1 class="text-primary">Tipo de Cliente</h1>

    <h4 class="pt-2">Confirma a Exclusão?</h4>

    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
    </dl>

    <div class="row pt-3">
        <div class="col-md-4">
            <form asp-action="Delete" class="pt-4">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" id="Id" name="Id" value="@Model?.Id" />
                <input type="submit" value="Excluir" class="btn btn-danger" />
            </form>
        </div>
    </div>
</div>

<div class="pt-4">
    <a asp-action="Index">Voltar para Lista</a>
</div>
