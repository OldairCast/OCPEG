@model OCPEG.Web.ViewModels.CustomerTypeViewModel

@{
    ViewData["Title"] = "Tipo de Cliente";
}

<br/>
<br/>
<div class="container p-4 border">
    <div class="row pb-2">
        <div class="col">
            <h1 class="text-primary">Tipo de Cliente</h1>
        </div>
        <div class="col text-end pt-1">
            <a asp-action="Create" class="btn btn-outline-primary">
                <i class="fas fa-plus"></i>&nbsp;Novo
            </a>
        </div>
    </div>   
    
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.CustomerType!.Id)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.CustomerType!.Name)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        
            @{
                if (Model.CustomerTypes == null || !Model.CustomerTypes.Any()) {
                    <tr>
                        <td colspan="3" class="text-center">Nenhum tipo de cliente encontrado.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model.CustomerTypes)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Id)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Name)
                            </td>
                            <td>
                                <a asp-action="Edit" class="btn btn-outline-success" asp-route-id="@item.Id">
                                    <i class="fas fa-edit"></i>&nbsp;Alterar
                                </a>
                                <a asp-action="Delete" class="btn btn-outline-danger" asp-route-id="@item.Id">
                                    <i class="fas fa-trash"></i>&nbsp;Excluir
                                </a>
                            </td>
                        </tr>
                    }
                }
            }
            
        </tbody>
    </table>
</div>

<div>
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
</div>