@model OCPEG.Web.ViewModels.ResolutionViewModel

<br />
<br />
<div class="container border p-3">
    <h1 class="text-primary">Resolução</h1>

    <h4 class="pt-2">Inclusão</h4>

    <div class="row pt-3">
        <div class="col-md-4">
            <form id="frmCreate" asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
                <dl class="row">
                    <dt class = "col-sm-4">
                        <label>Protocolo</label>
                    </dt>
                    <dd class = "col-sm-10">
                        @Html.DisplayFor(model => model.CallNumber)
                    </dd>
                </dl>

                <div class="form-group pt-3">
                    <label asp-for="Comment" class="control-label">Comentário</label>
                    <textarea asp-for="Comment" rows="5" cols="40" class="form-control"></textarea>
                    <span asp-validation-for="Comment" class="text-danger"></span>
                </div>

                <input type="hidden" id="CallNumber" name="CallNumber" value="@Model.CallNumber" />

                <div class="form-group pt-4">
                    <input type="submit" value="Salvar" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
</div>

<div class="pt-4">
    <a href="/Call">Voltar para Lista</a>
</div>



