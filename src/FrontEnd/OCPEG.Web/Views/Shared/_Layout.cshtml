<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OCPEG.Web</title>

    <link rel="shortcut icon" href="/images/Ocfavicon.png" type="image/x-icon">
    <link rel="icon" href="/images/Ocfavicon.png" type="image/x-icon">


    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/peg.css" asp-append-version="true" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/ocPeg.js"></script>
    <script src="~/js/call.js"></script>
    <script src="https://kit.fontawesome.com/2b7ec6a0d1.js" crossorigin="anonymous"></script>

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index"><img width="252" src="/images/OcPegPlataforma.png" /></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/OcPeg/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/Configurations/Index">Cadastros</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/Call/Index">Atendimento</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/Actions/Index">Ações</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/Login/Index">Sair</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <br />
    <br />
    <div class="text-center">
        <h3 class="display-5" style="color: #113a8f">Controle de Atendimentos - OC CRM</h3>
    </div>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - OCPEG.Web - Oldair Luis Castello
        </div>
    </footer>

</body>
</html>
