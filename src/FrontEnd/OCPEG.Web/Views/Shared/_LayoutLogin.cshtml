<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] OC PEG</title>
   
    <link rel="shortcut icon" href="/images/Ocfavicon.png" type="image/x-icon">
    <link rel="icon" href="/images/Ocfavicon.png" type="image/x-icon">
   
    <link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />
    
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
    
    @await RenderSectionAsync("Scripts", required: false)

    <style>
            .google {
                display: inline-block;
                padding: 3px 8px 3px 8px;
                width: 241px;
                height: 40px;
                cursor: pointer;
                background-size: 80%;
                background-position: center;
                background-repeat: no-repeat;
                vertical-align: middle;
                margin: 0px auto 9px 120px;
                background-image: url(../images/google.jpg);
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
               <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index"><img width="252" src="/images/OcPegPlataforma.png" /></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/login/Register">Novo Usuario</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/Login/Index">Login</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="text-center">
        <h1 class="display-6">Controle de Atendimentos</h1>
    </div>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>


</body>
</html>


