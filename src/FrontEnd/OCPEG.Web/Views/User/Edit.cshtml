@model OCPEG.Web.ViewModels.UserViewModel
 
@{
    ViewData["Title"] = "Usuario";
}

<br />
<br />
<div class="container border p-3">
    <h1 class="text-primary">Usuário</h1>

    <h4 class="pt-2">Alteração</h4>

    <div class="row pt-3">
        <div class="col-md-4">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group pt-4">
                    <label asp-for="User.Name" class="control-label"></label>
                    <input asp-for="User.Name" class="form-control" />
                    <span asp-validation-for="User.Name" class="text-danger"></span>
                </div>
                <div class="form-group pt-4">
                    <label asp-for="User.Email" class="control-label"></label>
                    <input asp-for="User.Email" class="form-control" />
                    <span asp-validation-for="User.Email" class="text-danger"></span>
                </div>
                <div class="form-group pt-4">
                    <label asp-for="User.PhoneNumber" class="control-label"></label>
                    <input asp-for="User.PhoneNumber" class="form-control" />
                    <span asp-validation-for="User.PhoneNumber" class="text-danger"></span>
                </div>
                <div class="form-group pt-4">
                    <label asp-for="Role" class="control-label">Perfil</label>

                    <select id="Profile" name="User.ProfileId" class="btn btn-secondary dropdown-toggle">
                        @{
                            if (Model.Role != null)
                            {
                                foreach (var item in Model.Role)
                                {
                                    if (item.Id == Model.RoleId)
                                    {
                                        <option value="@item.Id" selected=selected>@item.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Id">@item.Name</option>
                                    }
                                }
                            }        
                        }
                    </select>
                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>

                <div class="form-group pt-4">
                    <label asp-for="Function" class="control-label">Função</label>
                    <select id="Function" name="User.Function" class="btn btn-secondary dropdown-toggle">
                    @{
                        <option value="">--- Selecionar ---</option>
                            
                        if (Model.Function != null && Model.Function.Count > 0)
                        {
                            foreach (var item in Model.Function)
                            {
                                if (item.Id == Model.FunctionId)
                                {
                                    <option value="@item.Id" selected=selected>@item.Name</option>
                                }
                                else
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            }
                        }
                    }

                    </select>
                    <span asp-validation-for="Function" class="text-danger"></span>
                </div>

                <input type="hidden" id="User.Id" name="User.Id" value="@Model?.User?.Id" /> 
                <div class="form-group pt-4">
                    <input type="submit" value="Salvar" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
</div>


<div class="pt-4">
    <a asp-action="Index">Voltar para Lista</a>
</div>

