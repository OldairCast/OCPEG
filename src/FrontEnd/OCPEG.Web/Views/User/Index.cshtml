@model IEnumerable<OCPEG.Domain.Dto.UserDto>
 
@{
    ViewData["Title"] = "Usuario";
}

<br/>
<br/>
<div class="container p-4 border">
    <div class="row pb-2">
        <div class="col">
            <h1 class="text-primary">Usuário</h1>
        </div>
        <div class="col text-end pt-1">
            <a asp-action="Create" class="btn btn-outline-primary">
                <i class="fas fa-plus"></i>&nbsp;Novo
            </a>

            @*<a asp-action="Create">Novo</a>*@
         </div>
    </div>   
    
    <table class="table">
        <thead>
            <tr>
                <th>
                    Nome
                </th>
                <th>
                    Email
                </th>
                <th>
                    Telefone
                </th>
                <th>
                    Perfil
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PhoneNumber)
                </td>
                <td>
                    <a asp-action="Edit" class="btn btn-outline-success" asp-route-id="@item.Id">
                        <i class="fas fa-edit"></i>&nbsp;Alterar
                    </a>
                    <a asp-action="Delete" class="btn btn-outline-danger" asp-route-id="@item.Id">
                        <i class="fas fa-trash"></i>&nbsp;Excluir
                    </a>

                </td>
            </tr>
    }
        </tbody>
    </table>
</div>

<div>
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
</div> 